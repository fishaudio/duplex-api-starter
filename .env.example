# Fish Audio API Key (required for live voice sessions)
FISH_API_KEY=your_fish_api_key_here

# Fish Audio Realtime WebSocket endpoint (/converse = server turn detection)
FISH_REALTIME_URL=wss://api.fish.audio/v1/realtime/converse

# Google Cloud Vertex AI Service Account JSON path (for Gemini LLM brain)
VERTEX_CREDENTIALS_PATH=/path/to/your-vertex-service-account.json
VERTEX_LOCATION=global

# Optional server port
PORT=8080
