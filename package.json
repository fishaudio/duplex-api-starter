{
  "name": "fish-realtime-agent-starter",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Full-stack TypeScript reference voice agent using Fish Audio Realtime (/v1/realtime/converse), eager turns, tool calling, and backend ambience mixing",
  "scripts": {
    "dev": "concurrently -k -n server,client -c cyan,yellow \"tsx watch src/server/index.ts\" \"vite\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "tsx src/server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@google/genai": "^1.0.0",
    "@msgpack/msgpack": "^3.1.1",
    "google-auth-library": "^9.15.1",
    "mpg123-decoder": "^0.4.12",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "smol-toml": "^1.3.1",
    "ws": "^8.18.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/ws": "^8.18.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.3",
    "typescript": "~5.7.3",
    "vite": "^6.2.0",
    "vitest": "^3.0.7"
  }
}
